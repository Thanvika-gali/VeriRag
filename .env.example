# ==========================================
# VeriRAG Environment Configuration
# ==========================================

# Server Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database & Storage
SQLITE_DB_PATH=submissions.db
CHROMADB_PERSIST_DIR=chromadb_data

# RAG & Embedding Model Configuration
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
DEFAULT_TOP_K=5
CHUNK_SIZE=500
CHUNK_OVERLAP=50

